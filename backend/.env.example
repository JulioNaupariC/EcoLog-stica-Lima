# Optional for /health and OpenAPI. Required for database commands.
# Supply a real URL privately through the environment or an ignored .env file.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
APP_ENV=development
DB_CONNECT_TIMEOUT=5
SESSION_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
# Dedicated disposable database, never implicitly taken from DATABASE_URL.
# Migration tests create/drop usuario, auditoria and sesion in an empty test DB.
TEST_DATABASE_URL=
# ST-047 (ECL-96): optimization depot (WGS84) and engine search limit (1-40 s).
# Defaults: assumed depot in Santa Anita and 20 s, inside RNF-001 (P95 <= 45 s).
DEPOSITO_LATITUD=-12.0470
DEPOSITO_LONGITUD=-76.9680
OPTIMIZACION_TIEMPO_LIMITE_S=20
