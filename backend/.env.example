# Optional for /health and OpenAPI. Required for database commands.
# Supply a real URL privately through the environment or an ignored .env file.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
APP_ENV=development
DB_CONNECT_TIMEOUT=5
# Dedicated disposable database, never implicitly taken from DATABASE_URL.
# Migration integration tests create and drop usuario only in an empty test DB.
TEST_DATABASE_URL=
